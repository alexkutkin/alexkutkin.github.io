---
const site = Astro.site ?? new URL("https://alexkutkin.github.io");
const canonical = new URL("/", site).href;
const ogImage = new URL("/og.png", site).href;
import { getDictionary, locales } from "../i18n";
const { homeTitle, homeDescription } = getDictionary("en").meta;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{homeTitle}</title>
    <meta name="description" content={homeDescription} />
    <link rel="canonical" href={canonical} />
    {locales.map((locale) => <link rel="alternate" hreflang={locale} href={new URL(`/${locale}/`, site).href} />)}
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="application-name" content="Alex Kutkin personal site" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={homeTitle} />
    <meta property="og:description" content={homeDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Alex Kutkin" />
    <meta property="og:locale" content="en_US" />
    <script is:inline>
      (function () {
        var target;
        try {
          target = localStorage.getItem("locale");
        } catch (error) {}
        if (target !== "en" && target !== "ru") {
          var languages = navigator.languages || [navigator.language || "en"];
          target = /^ru\b/i.test(languages[0]) ? "ru" : "en";
        }
        window.location.replace("/" + target + "/");
      })();
    </script>
    <style is:inline>
      body {
        margin: 0;
        padding: 3rem 1.5rem;
        background: #f7f2e8;
        color: #202a34;
        font-family: system-ui, sans-serif;
        line-height: 1.5;
      }
      a {
        color: #59547e;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Alex Kutkin</h1>
      <p>
        <a href="/en/" hreflang="en" lang="en">English</a>
        &middot;
        <a href="/ru/" hreflang="ru" lang="ru">Русский</a>
      </p>
    </main>
  </body>
</html>
