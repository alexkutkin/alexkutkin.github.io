---
import SiteHead from "../components/SiteHead.astro";
import { getDictionary, locales, defaultLocale } from "../i18n";
const { homeTitle, homeDescription } = getDictionary(defaultLocale).meta;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead lang={defaultLocale} title={homeTitle} description={homeDescription} />
    <script define:vars={{ locales, defaultLocale }}>
      (function () {
        var target;
        try {
          target = localStorage.getItem("locale");
        } catch (error) {}
        if (!locales.includes(target)) {
          var languages = navigator.languages || [navigator.language || defaultLocale];
          var preferred = (languages[0] || defaultLocale).toLowerCase().split("-")[0];
          target = locales.includes(preferred) ? preferred : defaultLocale;
        }
        window.location.replace("/" + target + "/");
      })();
    </script>
    <style is:inline>
      body {
        margin: 0;
        padding: 3rem 1.5rem;
        background: #f7f2e8;
        color: #202a34;
        font-family: system-ui, sans-serif;
        line-height: 1.5;
      }
      a {
        color: #59547e;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Alex Kutkin</h1>
      <p>
        <a href="/en/" hreflang="en" lang="en">English</a>
        &middot;
        <a href="/ru/" hreflang="ru" lang="ru">Русский</a>
      </p>
    </main>
  </body>
</html>
