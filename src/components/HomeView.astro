---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "./Icon.astro";
import NoteCard from "./NoteCard.astro";
import Pagination from "./Pagination.astro";
import PortraitCard from "./PortraitCard.astro";
import { getDictionary, type Locale } from "../i18n";
import { articleSlug, type ArticleEntry } from "../lib/articles";
import { projects } from "../projects";
import "../styles/home.css";

interface PageData {
  data: ArticleEntry[];
  currentPage: number;
  lastPage: number;
}

interface Props {
  page: PageData;
  lang: Locale;
}

const { page, lang } = Astro.props;
const t = getDictionary(lang);

const notes = page.data.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  href: `/${lang}/article/${articleSlug(entry)}/`,
}));
---

<BaseLayout
  lang={lang}
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  section="home"
>
  <div class="home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__text">
        <h1 id="home-title" class="home-title">{t.authorName}</h1>
        <div class="home-hero__copy">
          <p class="home-intro">{t.home.intro}</p>
          {t.home.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="home-hero__aside">
        <PortraitCard alt={t.home.photoAlt} caption={t.home.photoCaption} />
      </div>
    </section>

    <section class="home-projects" aria-label={t.home.projectsLabel}>
      <p class="section-label">{t.home.projectsLabel}</p>
      <div class="project-list">
        {
          projects.map((project) => (
            <article class="project">
              <h2 class="project__title">{project.title}</h2>
              <p class="project__description">{t.home.projects[project.id]}</p>
              <a class="project__link" href={project.href}>
                <Icon name="github" />
                <span>GitHub</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="home-notes" aria-labelledby="notes-title">
      <h2 id="notes-title" class="home-notes__title">{t.home.notesTitle}</h2>
      <ol class="note-list">
        {
          notes.map((note) => (
            <NoteCard
              title={note.title}
              description={note.description}
              date={note.date}
              href={note.href}
              lang={lang}
            />
          ))
        }
      </ol>
      <Pagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        lang={lang}
      />
    </section>

    <section class="home-contacts" aria-label={t.home.contactLabel}>
      <div class="contact-group">
        <p class="section-label">{t.home.contactLabel}</p>
        <p class="contact-intro">{t.home.contactIntro}</p>
        <a class="contact-link" href="https://t.me/alxt">
          <Icon name="telegram" />
          <span>{t.home.telegram}</span>
        </a>
        <a class="contact-link" href="mailto:hi@alexkutkin.com">
          <Icon name="mail" />
          <span>hi@alexkutkin.com</span>
        </a>
      </div>
      <div class="contact-group">
        <p class="section-label">{t.home.socialsLabel}</p>
        <a class="contact-social" href="https://github.com/alexkutkin">
          <Icon name="github" />
          <span>GitHub</span>
        </a>
        <a class="contact-social" href="https://x.com/alex_kutkin">
          <Icon name="x" />
          <span>X</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
