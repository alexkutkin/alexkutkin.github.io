---
import Icon from "./Icon.astro";
import type { Dictionary } from "../i18n";

interface Props {
  labels: Dictionary["theme"];
  label: string;
}

const { labels, label } = Astro.props;
---

<div class="theme-control">
  <button class="theme-control__toggle" type="button" aria-label={label} aria-expanded="false" aria-controls="theme-options">
    <Icon name="sun" />
  </button>
<fieldset class="theme-switch" id="theme-options">
  <legend class="visually-hidden">{label}</legend>
  <label class="theme-switch__option">
    <input class="visually-hidden" type="radio" name="theme" value="system" checked />
    <Icon name="monitor" />
    <span class="visually-hidden">{labels.system}</span>
  </label>
  <label class="theme-switch__option">
    <input class="visually-hidden" type="radio" name="theme" value="light" />
    <Icon name="sun" />
    <span class="visually-hidden">{labels.light}</span>
  </label>
  <label class="theme-switch__option">
    <input class="visually-hidden" type="radio" name="theme" value="dark" />
    <Icon name="moon" />
    <span class="visually-hidden">{labels.dark}</span>
  </label>
</fieldset>
</div>

<script>
  import { themeChangeEvent } from "../lib/theme";

  const themeKey = "theme";
  const root = document.documentElement;
  const themeInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="theme"]'),
  );
  const storedTheme = () => {
    try {
      return localStorage.getItem(themeKey) ?? "system";
    } catch (error) {
      return "system";
    }
  };
  const syncThemeInputs = () => {
    const mode = storedTheme();
    for (const input of themeInputs) {
      input.checked = input.value === mode;
    }
  };
  const applyTheme = (mode: string) => {
    if (mode === "system") {
      root.removeAttribute("data-theme");
      try {
        localStorage.removeItem(themeKey);
      } catch (error) {}
    } else {
      root.dataset.theme = mode;
      try {
        localStorage.setItem(themeKey, mode);
      } catch (error) {}
    }
    syncThemeInputs();
    document.dispatchEvent(new CustomEvent(themeChangeEvent));
  };
  for (const input of themeInputs) {
    input.addEventListener("change", () => {
      if (input.checked) applyTheme(input.value);
    });
  }
  const colorScheme = window.matchMedia("(prefers-color-scheme: dark)");
  colorScheme.addEventListener("change", () => {
    if (storedTheme() === "system") {
      document.dispatchEvent(new CustomEvent(themeChangeEvent));
    }
  });
  syncThemeInputs();

  const control = document.querySelector<HTMLElement>(".theme-control");
  const toggle = control?.querySelector<HTMLButtonElement>(".theme-control__toggle");
  const close = () => toggle?.setAttribute("aria-expanded", "false");
  toggle?.addEventListener("click", () => {
    toggle.setAttribute("aria-expanded", String(toggle.getAttribute("aria-expanded") !== "true"));
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !control?.contains(event.target)) close();
  });
  control?.addEventListener("change", () => {
    if (toggle?.getAttribute("aria-expanded") === "true") {
      close();
      toggle.focus();
    }
  });
  control?.addEventListener("focusout", (event) => {
    if (event.relatedTarget instanceof Node && !control.contains(event.relatedTarget)) close();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      close();
      toggle.focus();
    }
  });
</script>
