---
import { locales, switchLocalePath, type Locale } from "../i18n";

interface Props {
  lang: Locale;
  pathname: string;
  label: string;
}

const { lang, pathname, label } = Astro.props;
---

<nav class="language-switch" aria-label={label}>
  {locales.map((locale, index) => (
    <>
      {index > 0 && <span class="language-switch__separator" aria-hidden="true">/</span>}
      <a
        class:list={["language-switch__link", { "is-active": lang === locale }]}
        href={switchLocalePath(pathname, locale)}
        hreflang={locale}
        lang={locale}
        data-set-locale={locale}
        aria-current={lang === locale ? "true" : undefined}
      >
        {locale.toUpperCase()}
      </a>
    </>
  ))}
</nav>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-set-locale]")) {
    link.addEventListener("click", () => {
      try {
        localStorage.setItem("locale", link.lang);
      } catch (error) {}
    });
  }
</script>
