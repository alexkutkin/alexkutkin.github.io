<span class="living-dot" data-living-dot aria-hidden="true">
  <svg viewBox="0 0 32 32" focusable="false">
    <circle class="living-dot__body" cx="16" cy="16" r="15" />
    <circle class="living-dot__eye" cx="17.5" cy="14" r="8" />
    <circle class="living-dot__pupil" cx="20" cy="14" r="3.3" />
  </svg>
</span>

<style>
  .living-dot {
    display: block;
    flex: none;
    inline-size: 1rem;
    block-size: 1rem;
    color: var(--color-accent);
  }

  .living-dot svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }

  .living-dot__body { fill: currentColor; }
  .living-dot__eye {
    fill: var(--color-bg);
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleY(0);
    transition: transform 140ms ease-out;
  }
  .living-dot__pupil {
    fill: var(--color-accent);
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 140ms ease-out;
  }
  .living-dot[data-state="look"] .living-dot__eye,
  .living-dot[data-state="left"] .living-dot__eye,
  .living-dot[data-state="right"] .living-dot__eye {
    transform: scaleY(1);
  }
  .living-dot[data-state="look"] .living-dot__pupil,
  .living-dot[data-state="left"] .living-dot__pupil,
  .living-dot[data-state="right"] .living-dot__pupil {
    transform: scale(1);
  }
  .living-dot[data-state="left"] .living-dot__pupil { translate: -3px 0; }
  .living-dot[data-state="right"] .living-dot__pupil { translate: 2px 0; }

  @media (prefers-reduced-motion: reduce) {
    .living-dot__eye, .living-dot__pupil { transition: none; }
  }
</style>

<script>
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const dot = document.querySelector<HTMLElement>("[data-living-dot]");
  const brand = dot?.closest<HTMLAnchorElement>(".brand");
  if (dot && brand) {
    let idleTimer: number | undefined;
    let hideTimer: number | undefined;
    let sequenceTimer: number | undefined;
    let hovered = false;

    const clearSequence = () => {
      window.clearTimeout(hideTimer);
      window.clearTimeout(sequenceTimer);
    };
    const rest = () => { dot.dataset.state = "rest"; };
    const peek = (direction: "look" | "left" | "right") => {
      dot.dataset.state = direction;
    };
    const schedule = () => {
      window.clearTimeout(idleTimer);
      if (motion.matches || document.hidden || hovered) return;
      idleTimer = window.setTimeout(() => {
        peek(Math.random() < 0.5 ? "left" : "right");
        hideTimer = window.setTimeout(() => {
          rest();
          schedule();
        }, 650);
      }, 15000 + Math.random() * 10000);
    };
    const engage = () => {
      if (motion.matches) return;
      hovered = true;
      clearSequence();
      window.clearTimeout(idleTimer);
      peek("look");
      sequenceTimer = window.setTimeout(() => {
        if (hovered) peek("left");
      }, 550);
    };
    const disengage = () => {
      hovered = false;
      clearSequence();
      if (motion.matches) { rest(); return; }
      peek("right");
      hideTimer = window.setTimeout(() => { rest(); schedule(); }, 500);
    };

    brand.addEventListener("pointerenter", engage);
    brand.addEventListener("pointerleave", disengage);
    brand.addEventListener("focus", engage);
    brand.addEventListener("blur", disengage);
    document.addEventListener("visibilitychange", () => {
      clearSequence();
      window.clearTimeout(idleTimer);
      rest();
      if (!document.hidden) schedule();
    });
    motion.addEventListener("change", () => {
      clearSequence();
      window.clearTimeout(idleTimer);
      rest();
      schedule();
    });
    schedule();
  }
</script>
