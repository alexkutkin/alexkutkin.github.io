<span class="living-dot" data-living-dot data-state="name" aria-hidden="true">
  <svg viewBox="0 0 32 32" focusable="false">
    <circle class="living-dot__body" cx="16" cy="16" r="15" />
    <circle class="living-dot__eye" cx="17.5" cy="14" r="8" />
    <circle class="living-dot__pupil" cx="20" cy="14" r="3.3" />
  </svg>
</span>

<style>
  .living-dot {
    display: block;
    flex: none;
    inline-size: 1em;
    block-size: 1em;
    color: var(--color-accent);
  }

  .living-dot svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }

  .living-dot__body { fill: currentColor; }
  .living-dot__eye {
    fill: var(--color-bg);
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .living-dot__pupil {
    fill: var(--color-accent);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1),
      translate 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* The pupil sits right of the eye centre: name rests toward the author
     name, reader centres it, away is a shy down-left glance. */
  .living-dot[data-state="name"] .living-dot__pupil { translate: 0 0; }
  .living-dot[data-state="reader"] .living-dot__pupil { translate: -2.5px 0; }
  .living-dot[data-state="away"] .living-dot__pupil { translate: -6px 2px; }

  .living-dot[data-blink] .living-dot__eye {
    transform: scale(1.06, 0.04);
    transition-duration: 70ms;
    transition-timing-function: ease-out;
  }
  .living-dot[data-blink] .living-dot__pupil {
    transform: scale(0);
    transition-duration: 70ms;
    transition-timing-function: ease-out;
  }
  .living-dot[data-blink="half"] .living-dot__eye {
    transform: scale(1.02, 0.45);
  }
  .living-dot[data-blink="half"] .living-dot__pupil {
    transform: scale(0.75);
  }

  .living-dot[data-slow-blink] .living-dot__eye {
    animation: living-dot-slow-blink-eye 1.3s ease-in-out;
  }
  .living-dot[data-slow-blink] .living-dot__pupil {
    animation: living-dot-slow-blink-pupil 1.3s ease-in-out;
  }

  @keyframes living-dot-slow-blink-eye {
    0%, 8% { transform: scale(1); }
    14%, 20% { transform: scale(1.02, 0.45); }
    26%, 34% { transform: scale(1); }
    40%, 78% { transform: scale(1.02, 0.45); }
    86%, 100% { transform: scale(1); }
  }

  @keyframes living-dot-slow-blink-pupil {
    0%, 8% { transform: scale(1); }
    14%, 20% { transform: scale(0.75); }
    26%, 34% { transform: scale(1); }
    40%, 78% { transform: scale(0.75); }
    86%, 100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .living-dot__eye, .living-dot__pupil { transition: none; }
    .living-dot[data-slow-blink] .living-dot__eye,
    .living-dot[data-slow-blink] .living-dot__pupil { animation: none; }
  }
</style>

<script>
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const dot = document.querySelector<HTMLElement>("[data-living-dot]");
  const brand = dot?.closest<HTMLAnchorElement>(".brand");
  if (dot && brand) {
    let hovering = false;
    let greeted = false;
    let slowBlinking = false;
    let blinkTimer: number | undefined;
    let blinkOffTimer: number | undefined;
    let secondBlinkTimer: number | undefined;
    let glanceTimer: number | undefined;
    let glanceRestTimer: number | undefined;
    let greetingTimer: number | undefined;
    let slowBlinkTimer: number | undefined;
    let slowBlinkOffTimer: number | undefined;
    let hoverTimers: number[] = [];

    const clearHoverTimers = () => {
      for (const timer of hoverTimers) window.clearTimeout(timer);
      hoverTimers = [];
    };

    const clearTimers = () => {
      window.clearTimeout(blinkTimer);
      window.clearTimeout(blinkOffTimer);
      window.clearTimeout(secondBlinkTimer);
      window.clearTimeout(glanceTimer);
      window.clearTimeout(glanceRestTimer);
      window.clearTimeout(greetingTimer);
      window.clearTimeout(slowBlinkTimer);
      window.clearTimeout(slowBlinkOffTimer);
      clearHoverTimers();
      delete dot.dataset.blink;
      delete dot.dataset.slowBlink;
      slowBlinking = false;
    };

    const open = () => {
      delete dot.dataset.blink;
      dot.dataset.state = "name";
    };

    const blink = () => {
      if (slowBlinking) return;
      delete dot.dataset.blink;
      // Force a frame so two quick blinks are two separate transitions.
      void dot.offsetWidth;
      const half = Math.random() < 0.12;
      dot.dataset.blink = half ? "half" : "";
      blinkOffTimer = window.setTimeout(() => {
        delete dot.dataset.blink;
      }, half ? 170 : 110);
    };

    const scheduleBlink = () => {
      window.clearTimeout(blinkTimer);
      if (motion.matches || document.hidden || hovering) return;
      blinkTimer = window.setTimeout(() => {
        blink();
        if (Math.random() < 0.25) {
          secondBlinkTimer = window.setTimeout(blink, 280);
        }
        scheduleBlink();
      }, 3500 + Math.random() * 3000);
    };

    const scheduleGlance = () => {
      window.clearTimeout(glanceTimer);
      if (motion.matches || document.hidden || hovering) return;
      glanceTimer = window.setTimeout(() => {
        dot.dataset.state = Math.random() < 0.5 ? "reader" : "away";
        glanceRestTimer = window.setTimeout(() => {
          open();
          scheduleGlance();
        }, 900);
      }, 20000 + Math.random() * 20000);
    };

    const scheduleSlowBlink = () => {
      window.clearTimeout(slowBlinkTimer);
      if (motion.matches || document.hidden || hovering) return;
      slowBlinkTimer = window.setTimeout(() => {
        if (motion.matches || document.hidden || hovering) {
          scheduleSlowBlink();
          return;
        }
        open();
        slowBlinking = true;
        dot.dataset.slowBlink = "";
        slowBlinkOffTimer = window.setTimeout(() => {
          delete dot.dataset.slowBlink;
          slowBlinking = false;
          scheduleBlink();
          scheduleSlowBlink();
        }, 1400);
      }, 120000 + Math.random() * 120000);
    };

    const greet = () => {
      if (greeted || motion.matches || document.hidden) return;
      greetingTimer = window.setTimeout(() => {
        if (hovering) return;
        greeted = true;
        dot.dataset.state = "reader";
        glanceRestTimer = window.setTimeout(open, 700);
      }, 1800);
    };

    const resume = () => {
      open();
      greet();
      scheduleBlink();
      scheduleGlance();
      scheduleSlowBlink();
    };

    const hoverLater = (state: "reader" | "away", delay: number) => {
      hoverTimers.push(window.setTimeout(() => {
        if (hovering) dot.dataset.state = state;
      }, delay));
    };

    const engage = () => {
      if (motion.matches) return;
      hovering = true;
      clearTimers();
      open();
      hoverLater("reader", 550);
      hoverLater("away", 1150);
      hoverLater("reader", 2050);
      hoverLater("away", 2450);
    };

    const disengage = () => {
      hovering = false;
      clearTimers();
      open();
      if (motion.matches) return;
      glanceRestTimer = window.setTimeout(resume, 500);
    };

    brand.addEventListener("pointerenter", engage);
    brand.addEventListener("pointerleave", disengage);
    brand.addEventListener("focus", engage);
    brand.addEventListener("blur", disengage);
    document.addEventListener("visibilitychange", () => {
      clearTimers();
      hovering = false;
      if (document.hidden) return;
      resume();
    });
    motion.addEventListener("change", () => {
      clearTimers();
      hovering = false;
      if (motion.matches) {
        open();
        return;
      }
      resume();
    });
    resume();
  }
</script>
