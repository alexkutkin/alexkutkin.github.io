---
import { getDictionary, type Locale } from "../i18n";
import ArticleDate from "./ArticleDate.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
  lang: Locale;
}

const { title, description, date, href, lang } = Astro.props;
const t = getDictionary(lang);
---

<li class="note">
  <ArticleDate class="note__date" date={date} lang={lang} />
  <div class="note__content">
    <h3 class="note__title">
      <a href={href}>{title}</a>
    </h3>
    <p class="note__summary">{description}</p>
    <a class="note__cta" href={href}>{t.article.open}</a>
  </div>
</li>
