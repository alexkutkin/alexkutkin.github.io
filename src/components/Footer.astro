---
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<footer class="site-footer center">
  <div class="site-footer__row">
    <p>© <span data-year>2026</span> {t.authorName}</p>
    <p class="site-footer__site">{t.footer.site}</p>
  </div>
</footer>
