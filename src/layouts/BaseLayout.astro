---
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/500.css";
import "@fontsource/manrope/600.css";
import "@fontsource-variable/literata/standard.css";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SiteHead from "../components/SiteHead.astro";
import { getDictionary, type Locale } from "../i18n";

import "../styles/tokens.css";
import "../styles/primitives.css";
import "../styles/global.css";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  section?: "home" | "cv" | "none";
  showLanguageSwitch?: boolean;
  canonicalPath?: string;
}

const {
  lang,
  title,
  description,
  section = "none",
  showLanguageSwitch = true,
  canonicalPath,
} = Astro.props;

const t = getDictionary(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <SiteHead lang={lang} title={title} description={description} canonicalPath={canonicalPath} rss />
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          if (theme === "light" || theme === "dark") {
            document.documentElement.dataset.theme = theme;
          }
        } catch (error) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <Header
      lang={lang}
      section={section}
      pathname={Astro.url.pathname}
      showLanguageSwitch={showLanguageSwitch}
    />
    <main id="main" class="page-main center">
      <slot />
    </main>
    <Footer t={t} />
  </body>
</html>
